<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#FF0A1030" android:centerColor="#FF141B45" android:endColor="#FF271C50"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="130dp" android:centerX="0.12" android:centerY="0.95" android:startColor="#44C040E0" android:endColor="#00000000"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="110dp" android:centerX="0.97" android:centerY="0.9" android:startColor="#44FF9A3C" android:endColor="#00000000"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#66FFFFFF"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
<ImageView android:id="@+id/tw_bgl" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tw_bg_l"/>
<ImageView android:id="@+id/tw_bgd" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tw_bg_d" android:visibility="gone"/>
<ImageView android:id="@+id/tw_bgs" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tw_bg_g1" android:visibility="gone"/>
<ImageView android:id="@+id/tw_deco" android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="bottom|left" android:layout_marginLeft="-42dp" android:layout_marginBottom="-42dp" android:scaleType="fitCenter" android:src="@drawable/tw_star" android:alpha="1"/>
<LinearLayout android:id="@+id/tw_body" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:gravity="center_vertical">
<TextView android:id="@+id/tw_wd" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:gravity="right" android:includeFontPadding="false" android:maxLines="1"/><TextView android:id="@+id/tw_d1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="26sp" android:gravity="right" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="2"/><TextView android:id="@+id/tw_d2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:gravity="right" android:includeFontPadding="false" android:maxLines="1"/><TextView android:id="@+id/tw_d3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:gravity="right" android:includeFontPadding="false" android:maxLines="1"/><TextView android:id="@+id/tw_hol" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:gravity="right" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:visibility="gone"/><TextClock android:id="@+id/tw_clk" android:layout_width="match_parent" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="34sp" android:gravity="right" android:includeFontPadding="false" android:layout_marginTop="4dp"/>
</LinearLayout>
<TextView android:id="@+id/tw_msg" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="16dp" android:textSize="13sp" android:visibility="gone"/>
</FrameLayout>
